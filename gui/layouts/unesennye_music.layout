       hexactsize 0
       vexactsize 0
       text "Play"
       font "gui/fonts/sdf_MetronBook24"
       "text halign" center
       "text valign" center
      }
     }
    }
    ButtonWidgetClass BtnStop {
     ignorepointer 0
